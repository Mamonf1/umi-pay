// UMI PAY — بوابة دفع: مخطط قاعدة البيانات
// العملة الأساسية: الليرة السورية (ل.س) — الدولار مكافئ عرض يديره الأدمن
// نقاط أومي: محفظة مكافآت تُمنح من الإدارة فقط (غير قابلة للبيع أو الشراء)
// الأمان: كلمة مرور المحفظة (8+ خانات حروف وأرقام) + رمز دفع منفصل (4 أرقام)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String         @id @default(cuid())
  name             String
  phone            String         @unique
  pass             String                     // كلمة مرور الدخول: 8 خانات أو أكثر (حروف + أرقام)
  pin              String         @default("1234") // رمز الدفع: 4 أرقام فقط (تأكيد المدفوعات)
  role             String         @default("individual") // individual | merchant | admin
  avatar           String         @default("👤")
  wallet           Wallet?
  merchant         Merchant?
  cards            TamayuzCard[]
  loans            LoanRequest[]
  sentMessages     ChatMessage[]  @relation("Sender")
  threadsA         ChatThread[]   @relation("ThreadA")
  threadsB         ChatThread[]   @relation("ThreadB")
  familyLink       FamilyMember?  @relation("Child")
  familiesAsParent FamilyMember[] @relation("Parent")
  txFrom           Transaction[]  @relation("TxFrom")
  txTo             Transaction[]  @relation("TxTo")
  friendsAdded     Friend[]       @relation("FriendOwner")
  friendOf         Friend[]       @relation("FriendUser")
  createdAt        DateTime       @default(now())
}

model Wallet {
  id      String @id @default(cuid())
  userId  String @unique
  balance Float  @default(0) // بالليرة السورية — العملة الأساسية
  points  Float  @default(0) // نقاط أومي — تُمنح من الإدارة فقط
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Merchant {
  id         String        @id @default(cuid())
  name       String
  category   String
  emoji      String
  color      String        @default("#7b5bc7")
  ownerId    String        @unique
  owner      User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  apiKey     String?       // مفتاح ربط API الخاص بالتاجر (يُولَّد تلقائياً عند أول فتح لقسم المعلومات)
  apiKeyAt   DateTime?     // تاريخ إنشاء/تجديد المفتاح
  webhookUrl String?       // رابط استلام إشعارات الدفع لدى التاجر
  txs        Transaction[]
}

model Transaction {
  id         String    @id @default(cuid())
  reference  String    @unique
  type       String // transfer | topup | merchant | allowance | loan | loan_repay
  amount     Float // بالليرة السورية
  status     String    @default("completed") // completed | failed
  note       String?
  fromUserId String?
  toUserId   String?
  merchantId String?
  from       User?     @relation("TxFrom", fields: [fromUserId], references: [id])
  to         User?     @relation("TxTo", fields: [toUserId], references: [id])
  merchant   Merchant? @relation(fields: [merchantId], references: [id])
  createdAt  DateTime  @default(now())
}

// طلبات القروض — بالليرة السورية، توافقها الإدارة ثم يُشحن الرصيد فوراً
// feesAccrued: رسوم التطبيق الشهرية المتراكمة (1.5% شهرياً على المتبقي) — تُضاف إلى المتبقي على المقترض
model LoanRequest {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Float // مبلغ القرض بالليرة
  paidAmount  Float     @default(0) // ما سُدّد حتى الآن
  feesAccrued Float     @default(0) // رسوم التطبيق المتراكمة على هذا القرض
  lastFeeAt   DateTime? // تاريخ آخر احتساب رسوم شهرية
  currency    String    @default("SYP")
  status      String    @default("pending") // pending | approved | rejected | paid
  note        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// صندوق أرباح المحفظة — كل إيراد يحققه التطبيق يدخل هذا الصندوق
// loan_fee: الرسوم الشهرية من القروض (1.5%) | card_fee: رسوم استعمال بطاقة الاعتماد (3.5%) | manual: إدخال يدوي من الأدمن
model ProfitEntry {
  id        String   @id @default(cuid())
  kind      String // loan_fee | card_fee | manual
  title     String
  amount    Float
  loanId    String?
  userId    String?
  note      String?
  createdAt DateTime @default(now())
}

// بطاقة التميز — نظام أمريكان إكسبريس (15 خانة)، شرط الإصدار رصيد 50,000 ل.س فأكثر
model TamayuzCard {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  number    String // 15 خانة بنظام AmEx — تُعرض مجمعة 4-6-5
  holder    String
  expiry    String // MM/YY
  tier      String   @default("GOLD")
  status    String   @default("active")
  createdAt DateTime @default(now())
}

model ChatThread {
  id        String        @id @default(cuid())
  userAId   String
  userBId   String
  userA     User          @relation("ThreadA", fields: [userAId], references: [id])
  userB     User          @relation("ThreadB", fields: [userBId], references: [id])
  messages  ChatMessage[]
  createdAt DateTime      @default(now())

  @@unique([userAId, userBId])
}

model ChatMessage {
  id        String     @id @default(cuid())
  threadId  String
  senderId  String
  kind      String     @default("text") // text | transfer | image | statement | report_request
  text      String?
  data      String?    // حمولة إضافية: dataURL للصور أو JSON لكشف الحساب
  amount    Float?
  txId      String?    @unique
  thread    ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender    User       @relation("Sender", fields: [senderId], references: [id])
  createdAt DateTime   @default(now())
}

model FamilyMember {
  id          String  @id @default(cuid())
  parentId    String
  childId     String  @unique
  weeklyLimit Float   @default(100000)
  frozen      Boolean @default(false)
  parent      User    @relation("Parent", fields: [parentId], references: [id])
  child       User    @relation("Child", fields: [childId], references: [id])
}

// تسعير الصرف — صف وحيد يديره أدمن المحفظة
// usdSyp: سعر الدولار مقابل الليرة السورية (يمكن مزامنته من مصدر موثوق)
// pointSyp: قيمة نقطة أومي الواحدة بالليرة — النقاط تُمنح من الإدارة ولا تُباع ولا تُشترى
model CurrencySettings {
  id              String   @id @default("main")
  usdSyp          Float    @default(13000)
  pointSyp        Float    @default(10)
  loanMonthlyRate Float    @default(1.5) // نسبة التطبيق من القروض شهرياً — بالمئة
  cardFeeRate     Float    @default(3.5) // نسبة استعمال بطاقة الاعتماد — بالمئة
  rateApiKey      String?  // مفتاح خدمة أسعار الصرف (اختياري) — يُستخدم قبل المصدر المجاني
  updatedAt       DateTime @updatedAt
}

// الأصدقاء — طلب صداقة (pending) ثم قبول (accepted) على الجهتين
model Friend {
  id        String   @id @default(cuid())
  userId    String
  friendId  String
  status    String   @default("pending") // pending: طلب بانتظار القبول | accepted: صديقان
  createdAt DateTime @default(now())
  user      User     @relation("FriendOwner", fields: [userId], references: [id])
  friend    User     @relation("FriendUser", fields: [friendId], references: [id])

  @@unique([userId, friendId])
}
